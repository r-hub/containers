FROM fedora:44

WORKDIR /root

RUN curl -L -o jags.tar.gz \
        https://master.dl.sourceforge.net/project/mcmc-jags/JAGS/5.x/Source/JAGS-5.0.2.tar.gz && \
    tar xzf jags.tar.gz && \
    rm jags.tar.gz

RUN dnf install -y gcc gfortran g++ flexiblas-devel libtool

RUN cd JAGS-* && \
    ./configure --prefix=/usr --with-blas='-lflexiblas' && \
    make && \
    make install DESTDIR=/opt/jags

RUN if [ "$(arch)" == "aarch64" ]; then echo arm64; else echo amd64; fi > /tmp/arch

RUN dnf install -y "https://github.com/goreleaser/nfpm/releases/download/v2.49.0/nfpm-2.49.0-1.$(arch).rpm"

COPY package.fedora-44 /root/package.sh

RUN /root/package.sh

COPY build.sh /root/build.sh
