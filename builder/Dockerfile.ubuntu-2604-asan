FROM ubuntu:resolute
RUN echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries

ENV OS_IDENTIFIER ubuntu-2604

# -------------------------------------------------------------------------
# Packages needed for compiling R

RUN sed -i "s|Types: deb|Types: deb deb-src|g" /etc/apt/sources.list.d/ubuntu.sources

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y curl libcurl4-openssl-dev libicu-dev \
    libopenblas0-pthread libpcre2-dev wget python3-pip

# Locales are needed because of a tex-common configuration bug

RUN apt-get update -y && \
    apt-get install -y locales && \
    locale-gen en_GB.UTF-8 && \
    update-locale
ENV LC_COLLATE C
ENV LANG en_GB.UTF-8

RUN apt-get update && \
    apt-get build-dep -y r-base

# -------------------------------------------------------------------------
# clang-23

RUN export DEBIAN_FRONTEND=noninteractive && \
    apt-get update -y && \
    apt-get install -y gpg && \
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL --retry 5 --retry-all-errors https://apt.llvm.org/llvm-snapshot.gpg.key | \
      gpg --dearmor -o /etc/apt/keyrings/apt.llvm.org.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/apt.llvm.org.gpg] http://apt.llvm.org/resolute/ llvm-toolchain-resolute-23 main" \
    > /etc/apt/sources.list.d/llvm.list && \
    apt-get update -y && \
    apt-get install -y clang-23 libc++abi-23-dev libc++-23-dev libomp-23-dev flang-23 && \
    apt-get clean

# -------------------------------------------------------------------------
# Packaging

RUN curl -LO "https://github.com/goreleaser/nfpm/releases/download/v2.18.1/nfpm_$(dpkg --print-architecture).deb" && \
    apt install -y "./nfpm_$(dpkg --print-architecture).deb" && \
    rm "nfpm_$(dpkg --print-architecture).deb"

RUN chmod 0777 /opt

# Override the default pager used by R
ENV PAGER /usr/bin/pager

# Note: Ubuntu 26 does not have PCRE1 (libpcre3), so R 3.x is not supported

COPY builder/config.ubuntu-2604-asan /config.site
COPY builder/package.ubuntu-2604-asan /package.sh
COPY build.sh .
ENTRYPOINT ./build.sh
