#!/bin/bash

if [[ ! -d /tmp/output/${OS_IDENTIFIER} ]]; then
  mkdir -p "/tmp/output/${OS_IDENTIFIER}"
fi

# Note: Ubuntu 26 does not have PCRE1 (libpcre3), so R 3.x is not supported
pcre_libs='- libpcre2-dev'

deflate_libs='# - libdeflate-dev'
if grep -q '^LIBS *=.*[-]ldeflate' /opt/R/${R_VERSION}${R_TYPE}/lib/R/etc/Makeconf; then
    deflate_libs='- libdeflate-dev'
fi

# R 4.5.0 and later require libzstd (with headers to link against libR)
zstd_libs='# - libzstd-dev'
if grep -q '^LIBS *=.*[-]lzstd' /opt/R/${R_VERSION}${R_TYPE}/lib/R/etc/Makeconf; then
    zstd_libs='- libzstd-dev'
fi

# Extract byte code from base R
# With --enable-R-shlib, lib/R/bin/exec/R just links against libR.so,
# so its own bitcode is missing most of the R runtime (e.g. R_gc_internal).
# Extract bitcode from both and merge them into one R.bc.
(
    cd /opt/R/devel-rchk/
    /opt/R/devel-rchk/python//bin/extract-bc lib/R/bin/exec/R
    /opt/R/devel-rchk/python//bin/extract-bc lib/R/lib/libR.so
    /usr/lib/llvm-21/bin/llvm-link -o R.bc \
        lib/R/bin/exec/R.bc lib/R/lib/libR.so.bc
    # remove stray bitcode files left next to the R binaries: R's own
    # multiarch detection scans these dirs and treats a stray file as
    # a bogus sub-architecture, breaking package installs
    rm -f lib/R/bin/exec/R.bc lib/R/lib/libR.so.bc
    # pre-compute the rchk cache for R.bc, so package checks do not
    # need to do it every time
    rchk/src/cachegen R.bc R.bc.cache
)

# Reset compilers in system config, so packages are normally installed
# without WLLVM
sed -i 's|/opt/R/devel-rchk/python/bin/wllvm|clang|g' \
    /opt/R/devel-rchk/lib/R/etc/Makeconf

# Update default compilers, add extra Makevars file that
# the check script can use

cat <<EOF > /tmp/nfpm.yml
name: r-${R_VERSION}${R_TYPE}
version: 1
version_schema: none
section: universe/math
priority: optional
arch: $(dpkg --print-architecture)
maintainer: Posit Software, PBC <https://github.com/rstudio/r-builds>
description: |
  GNU R statistical computation and graphics system
vendor: Posit Software, PBC
homepage: https://www.r-project.org
license: GPL-2
deb:
  fields:
    Bugs: https://github.com/rstudio/r-builds/issues
depends:
- clang
- file
- gfortran
- libbz2-dev
- libc++-dev
- libc++abi-dev
- libc6
- libcairo2
- libcurl4t64
${deflate_libs}
- libglib2.0-0t64
- libgomp1
- libicu-dev
- libjpeg8
- liblzma-dev
- libopenblas-dev
- libpango-1.0-0
- libpangocairo-1.0-0
- libpaper-utils
${pcre_libs}
- libpng16-16t64
- libreadline8t64
- libtcl8.6
- libtiff6
- libtirpc-dev
- libtk8.6
- libx11-6
- libxt6t64
${zstd_libs}
- libllvm21
- llvm
- make
- pkg-config
- python3
- ucf
- unzip
- zip
- zlib1g-dev
contents:
- src: /opt/R/${R_VERSION}${R_TYPE}
  dst: /opt/R/${R_VERSION}${R_TYPE}
EOF

nfpm package \
  -f /tmp/nfpm.yml \
  -p deb \
  -t "/tmp/output/${OS_IDENTIFIER}"

TMP=$(ls /tmp/output/${OS_IDENTIFIER}/r-${R_VERSION}${R_TYPE}*.deb | head -1)
mv "$TMP" $(echo $TMP | sed "s|/r-|/r-rstudio-${OS_IDENTIFIER}-|")

export PKG_FILE=$(ls /tmp/output/${OS_IDENTIFIER}/r-*.deb | head -1)
